<component>
	<api>
		<prop name="frame_width" type="int" default="320" />
		<prop name="frame_height" type="int" default="90" />

		<prop name="min_value" type="int" default="8800" />
		<prop name="max_value" type="int" default="10800" />

		<prop name="total_tick_count" type="int" default="201" />
		<prop name="major_tick_every" type="int" default="10" />

		<prop name="scale_pixel_width" type="int" default="2330" />
		<prop name="style_pad_hor" type="int" default="160" />

		<prop name="text_src" type="string[NULL]" default="NULL" />

		<prop name="needle_src" type="image" />
		<prop name="overlay_src" type="image" />
	</api>

	<styles>
		<style name="dial_scale_text" text_color="0xff6918" text_font="ui_font_Monaco20" />

		<style name="dial_scale_minor_ticks" line_color="0xffffff" line_width="2" line_opa="100%" length="20" />

		<style name="dial_scale_major_ticks" line_color="0xffffff" line_width="2" line_opa="100%" length="32" />
	</styles>

	<view
		extends="lv_obj"
		width="$frame_width"
		height="$frame_height"
		scrollbar_mode="off"
		style_radius="0"
		style_bg_color="0x000000"
		style_border_width="1"
		style_pad_all="0"
		scrollable="false"
	>
		<lv_obj
			name="dial_viewport"
			align="bottom_mid"
			width="$frame_width"
			height="$frame_height"
			scrollbar_mode="off"
			style_bg_color="0x000000"
			style_border_width="0"
			style_radius="0"
			style_pad_all="0"
			style_pad_bottom="0"
			scrollable="true"
			scroll_chain_hor="false"
			scroll_chain_ver="false"
			scroll_elastic="false"
			scroll_momentum="false"
		>
			<lv_scale
				name="dial_scale"
				align="bottom_left"
				total_tick_count="$total_tick_count"
				major_tick_every="$major_tick_every"
				min_value="$min_value"
				max_value="$max_value"
				mode="horizontal_top"
				angle_range="180"
				text_src="$text_src"
				style_min_width="$scale_pixel_width"
				style_height="$frame_height"
				style_pad_hor="$style_pad_hor"
				style_pad_bottom="5"
			>
				<style name="dial_scale_text" selector="indicator" />
				<style name="dial_scale_minor_ticks" selector="items" />
				<style name="dial_scale_major_ticks" selector="indicator" />
			</lv_scale>
		</lv_obj>

		<lv_obj
			name="dial_needle"
			width="62"
			height="17"
			align="bottom_mid"
			clickable="false"
			floating="true"
			scrollbar_mode="off"
			style_bg_image_src="$needle_src"
			style_radius="0"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_all="0"
		/>

		<lv_obj
			name="dial_overlay"
			width="$frame_width"
			height="$frame_height"
			align="bottom_mid"
			clickable="false"
			floating="true"
			scrollbar_mode="off"
			style_bg_image_src="$overlay_src"
			style_radius="0"
			style_bg_opa="0"
			style_border_opa="0"
		/>
	</view>
</component>
