<component>
	<api>
		<prop name="frame_width" type="int" default="120" />
		<prop name="frame_height" type="int" default="320" />

		<prop name="text_pad_right" type="int" default="10" />

		<prop name="min_value" type="int" default="10800" />
		<prop name="max_value" type="int" default="8800" />

		<prop name="total_tick_count" type="int" default="201" />
		<prop name="major_tick_every" type="int" default="10" />

		<prop name="scale_pixel_width" type="int" default="90" />
		<prop name="scale_pixel_height" type="int" default="2330" />
		<prop name="style_pad_hor" type="int" default="5" />
		<prop name="style_pad_ver" type="int" default="160" />

		<prop name="scale_angle_range" type="int" default="180" />
		<prop name="scale_align" type="string" default="top_left" />
		<prop name="scale_mode" type="string" default="vertical_right" />

		<prop name="viewport_align" type="string" default="center" />
		<prop name="viewport_width" type="int" default="120" />
		<prop name="viewport_height" type="int" default="320" />

		<prop name="needle_src" type="image" />
		<prop name="needle_width" type="int" default="62" />
		<prop name="needle_height" type="int" default="17" />
		<prop name="needle_align" type="string" default="left_mid" />
		<prop name="needle_x" type="int" default="0" />
		<prop name="needle_y" type="int" default="-40" />
		<prop name="needle_pivot_x" type="int" default="0" />
		<prop name="needle_pivot_y" type="int" default="17" />
		<prop name="needle_rotation" type="int" default="900" />

		<prop name="overlay_src" type="image" />
		<prop name="overlay_width" type="int" default="320" />
		<prop name="overlay_height" type="int" default="120" />
		<prop name="overlay_align" type="string" default="left_mid" />
		<prop name="overlay_x" type="int" default="0" />
		<prop name="overlay_y" type="int" default="-220" />
		<prop name="overlay_pivot_x" type="int" default="0" />
		<prop name="overlay_pivot_y" type="int" default="120" />
		<prop name="overlay_rotation" type="int" default="900" />
	</api>

	<styles>
		<style name="dial_scale_text" text_color="0xff6918" text_font="ui_font_Monaco20" pad_right="10" />

		<style name="dial_scale_minor_ticks" line_color="0xffffff" line_width="2" line_opa="100%" length="20" />

		<style name="dial_scale_major_ticks" line_color="0xffffff" line_width="2" line_opa="100%" length="32" />
	</styles>

	<view
		extends="lv_obj"
		width="$frame_width"
		height="$frame_height"
		scrollbar_mode="off"
		style_radius="0"
		style_bg_color="0x000000"
		style_border_width="0"
		style_pad_all="0"
		scrollable="false"
	>
		<lv_obj
			name="dial_viewport"
			align="$viewport_align"
			width="$viewport_width"
			height="$viewport_height"
			scrollbar_mode="off"
			style_bg_color="0x000000"
			style_border_width="0"
			style_radius="0"
			style_pad_all="0"
			style_pad_bottom="0"
			scrollable="true"
			scroll_chain_hor="false"
			scroll_chain_ver="false"
			scroll_elastic="false"
			scroll_momentum="false"
		>
			<lv_scale
				name="dial_scale"
				align="$scale_align"
				total_tick_count="$total_tick_count"
				major_tick_every="$major_tick_every"
				min_value="$min_value"
				max_value="$max_value"
				mode="$scale_mode"
				angle_range="$scale_angle_range"
				style_min_width="$scale_pixel_width"
				style_min_height="$scale_pixel_height"
				style_height="$frame_height"
				style_width="$frame_width"
				style_pad_hor="$style_pad_hor"
				style_pad_ver="$style_pad_ver"
			>
				<style name="dial_scale_text" selector="indicator" />
				<style name="dial_scale_minor_ticks" selector="items" />
				<style name="dial_scale_major_ticks" selector="indicator" />
			</lv_scale>
		</lv_obj>

		<lv_obj
			name="dial_needle"
			width="$needle_width"
			height="$needle_height"
			align="$needle_align"
			x="$needle_x"
			y="$needle_y"
			style_transform_pivot_x="$needle_pivot_x"
			style_transform_pivot_y="$needle_pivot_y"
			style_transform_rotation="$needle_rotation"
			clickable="false"
			floating="true"
			scrollbar_mode="off"
			style_bg_image_src="$needle_src"
			style_radius="0"
			style_bg_opa="0"
			style_border_width="0"
			style_pad_all="0"
		/>

		<lv_obj
			name="dial_overlay"
			width="$overlay_width"
			height="$overlay_height"
			align="$overlay_align"
			x="$overlay_x"
			y="$overlay_y"
			style_transform_pivot_x="$overlay_pivot_x"
			style_transform_pivot_y="$overlay_pivot_y"
			style_transform_rotation="$overlay_rotation"
			clickable="false"
			floating="true"
			scrollbar_mode="off"
			style_bg_image_src="$overlay_src"
			style_radius="0"
			style_bg_opa="0"
			style_border_opa="0"
			style_border_width="0"
		/>
	</view>
</component>
