<component>
	<api>
		<prop name="band_disp_align" type="string" default="top_mid" />
		<prop name="band_disp_width" type="int" default="70" />
		<prop name="band_disp_height" type="int" default="15" />
		<prop name="band_disp_x" type="int" default="15" />
		<prop name="band_disp_y" type="int" default="0" />

		<prop name="vfo_disp_align" type="string" default="top_mid" />
		<prop name="vfo_disp_width" type="int" default="180" />
		<prop name="vfo_disp_height" type="int" default="70" />
		<prop name="vfo_disp_x" type="int" default="0" />
		<prop name="vfo_disp_y" type="int" default="30" />

		<prop name="dial_bg_align" type="string" default="center" />
		<prop name="dial_bg_width" type="int" default="120" />
		<prop name="dial_bg_height" type="int" default="320" />
		<prop name="dial_bg_x" type="int" default="0" />
		<prop name="dial_bg_y" type="int" default="0" />

		<prop name="dial_container_align" type="string" default="bottom_mid" />
		<prop name="dial_container_width" type="int" default="120" />
		<prop name="dial_container_height" type="int" default="320" />

		<prop name="keyboard_align" type="string" default="center" />
		<prop name="keyboard_width" type="int" default="180" />
		<prop name="keyboard_height" type="int" default="180" />
		<prop name="keyboard_x" type="int" default="0" />
		<prop name="keyboard_y" type="int" default="0" />

		<prop name="dial_frame_width" type="int" default="120" />
		<prop name="dial_frame_height" type="int" default="320" />
		<prop name="dial_viewport_width" type="int" default="120" />
		<prop name="dial_viewport_height" type="int" default="320" />
		<prop name="dial_scale_pixel_width" type="int" default="90" />
		<prop name="dial_scale_pixel_height" type="int" default="2330" />
		<prop name="dial_style_pad_hor" type="int" default="5" />
		<prop name="dial_style_pad_ver" type="int" default="160" />
		<prop name="dial_scale_align" type="string" default="top_left" />
		<prop name="dial_scale_mode" type="string" default="vertical_right" />

		<prop name="dial_needle_src" type="image" default="needle_portrait" />
		<prop name="dial_needle_align" type="string" default="left_mid" />
		<prop name="dial_needle_width" type="int" default="17" />
		<prop name="dial_needle_height" type="int" default="62" />
		<prop name="dial_needle_x" type="int" default="4" />
		<prop name="dial_needle_y" type="int" default="0" />

		<prop name="dial_overlay_src" type="image" default="overlay_portrait" />
		<prop name="dial_overlay_align" type="string" default="left_mid" />
		<prop name="dial_overlay_width" type="int" default="120" />
		<prop name="dial_overlay_height" type="int" default="320" />
		<prop name="dial_overlay_x" type="int" default="0" />
		<prop name="dial_overlay_y" type="int" default="0" />

		<prop name="viewport_align" type="string" default="center" />
		<prop name="viewport_width" type="int" default="120" />
		<prop name="viewport_height" type="int" default="320" />

		<prop name="volume_slider_width" type="int" default="5" />
		<prop name="volume_slider_height" type="int" default="320" />
		<prop name="volume_slider_align" type="string" default="left_mid" />
		<prop name="volume_slider_x" type="int" default="10" />
		<prop name="volume_slider_y" type="int" default="0" />
	</api>
	<styles>
		<style name="ui_styleBandText" text_color="0xff6918" text_font="ui_font_Monaco20" text_align="left" />

		<style name="ui_styleVfoText" text_color="0xff6918" text_font="ui_font_Monaco40" text_align="right" />
		<style name="ui_styleVfoKeyboard" bg_color="0xffffff" text_color="0xff6918" bg_opa="5%" />

		<style name="ui_styleVolumeKnob" bg_opa="0" border_opa="0" shadow_opa="0" width="0" height="0" />
		<style name="ui_styleVolumeIndicator" bg_color="0xff6819" />
	</styles>

	<view
		extends="lv_obj"
		scrollbar_mode="off"
		scrollable="false"
		width="180"
		height="640"
		style_bg_color="0x000000"
		style_border_width="0"
		style_border_color="0x000000"
		style_radius="0"
		style_pad_all="0"
	>
		<lv_textarea
			name="ui_bandDisp"
			align="top_left"
			width="$band_disp_width"
			height="$band_disp_height"
			scrollbar_mode="off"
			text="FM"
			style_radius="0"
			style_bg_opa="0"
			style_border_width="0"
			one_line="true"
			x="$band_disp_x"
			y="$band_disp_y"
		>
			<style name="ui_styleBandText" />
		</lv_textarea>
		<lv_textarea
			name="ui_vfoDisp"
			align="top_mid"
			width="$vfo_disp_width"
			height="$vfo_disp_height"
			click_focusable="true"
			scrollbar_mode="off"
			placeholder_text="Set Freq"
			text="102.5"
			style_radius="0"
			style_bg_opa="0"
			style_border_width="0"
			one_line="true"
			x="$vfo_disp_x"
			y="$vfo_disp_y"
		>
			<style name="ui_styleVfoText" />
			<lv_obj-subject_set_int_event subject="vfo_keyboard_visible" value="1" trigger="clicked" />
		</lv_textarea>

		<lv_obj
			name="ui_dialScaleBackground"
			align="center"
			width="$dial_bg_width"
			height="$dial_bg_height"
			x="$dial_bg_x"
			y="$dial_bg_y"
			scrollbar_mode="off"
			scroll_chain_hor="false"
			scroll_chain_ver="false"
			scroll_elastic="false"
			scroll_momentum="false"
			style_radius="0"
			style_bg_color="0x000000"
			style_border_width="0"
			style_pad_all="0"
			scrollable="false"
		>
			<lv_obj
				name="ui_dialContainer"
				align="bottom_mid"
				width="$dial_container_width"
				height="$dial_container_height"
				style_bg_color="0x000000"
				style_border_width="0"
				style_radius="0"
				style_pad_all="0"
				style_pad_bottom="0"
				scrollbar_mode="off"
				scroll_chain_ver="false"
				scroll_chain_hor="false"
				scrollable="false"
			>
				<dial_scale_widget
					name="ui_mainDial"
					frame_width="$dial_frame_width"
					frame_height="$dial_frame_height"
					viewport_width="$dial_viewport_width"
					viewport_height="$dial_viewport_height"
					scale_pixel_width="$dial_scale_pixel_width"
					scale_pixel_height="$dial_scale_pixel_height"
					style_pad_hor="$dial_style_pad_hor"
					style_pad_ver="$dial_style_pad_ver"
					scale_align="$dial_scale_align"
					scale_mode="$dial_scale_mode"
					needle_align="$dial_needle_align"
					needle_x="$dial_needle_x"
					needle_y="$dial_needle_y"
					needle_width="$dial_needle_width"
					needle_height="$dial_needle_height"
					overlay_align="$dial_overlay_align"
					overlay_x="$dial_overlay_x"
					overlay_y="$dial_overlay_y"
					overlay_width="$dial_overlay_width"
					overlay_height="$dial_overlay_height"
					needle_src="$dial_needle_src"
					overlay_src="$dial_overlay_src"
				/>
			</lv_obj>
		</lv_obj>

		<volume_slider_widget align="left_mid" />

		<lv_obj
			name="ui_stepPopup"
			align="center"
			width="150"
			height="180"
			hidden="true"
			scrollable="false"
			scrollbar_mode="off"
			style_radius="0"
			style_bg_color="0x101010"
			style_bg_opa="95%"
			style_border_color="0xff6918"
			style_border_width="1"
			style_pad_all="4"
		>
			<lv_obj
				name="ui_stepList"
				width="142"
				height="172"
				align="center"
				scrollable="true"
				scrollbar_mode="auto"
				style_radius="0"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
			/>
		</lv_obj>

		<lv_obj
			name="ui_bandPopup"
			align="center"
			width="172"
			height="560"
			hidden="true"
			scrollable="false"
			scrollbar_mode="off"
			style_radius="0"
			style_bg_color="0x101010"
			style_bg_opa="95%"
			style_border_color="0xff6918"
			style_border_width="1"
			style_pad_all="4"
		>
			<lv_obj
				name="ui_bandList"
				width="164"
				height="552"
				align="center"
				scrollable="true"
				scrollbar_mode="auto"
				style_radius="0"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
			/>
		</lv_obj>

		<lv_obj
			name="ui_volumeLabelPopup"
			align="center"
			width="content"
			height="content"
			hidden="true"
			scrollable="false"
			scrollbar_mode="off"
			style_radius="5"
			style_bg_color="0x101010"
			style_bg_opa="95%"
			style_border_color="0xff6918"
			style_border_width="1"
			style_text_color="0xff6918"
			style_text_font="ui_font_Monaco40"
			style_text_align="center"
			style_pad_all="0"
			y="-130"
		>
			<lv_label
				name="ui_volumeLabel"
				style_text_align="right"
				width="110"
				text="30%"
				style_pad_top="10"
				style_pad_bottom="5"
				style_pad_right="8"
			/>
		</lv_obj>

		<lv_keyboard
			name="ui_vfoKeyboard"
			align="center"
			width="$keyboard_width"
			height="$keyboard_height"
			x="$keyboard_x"
			y="$keyboard_y"
			mode="number"
			style_bg_color="0x101010"
		>
			<style name="ui_styleVfoKeyboard" selector="items" />
			<style name="ui_styleVfoKeyboard" selector="items|checked" />
			<lv_obj-bind_flag_if_eq subject="vfo_keyboard_visible" flag="hidden" ref_value="0" />
			<lv_obj-subject_set_int_event subject="vfo_keyboard_visible" value="0" trigger="ready" />
			<lv_obj-subject_set_int_event subject="vfo_keyboard_visible" value="0" trigger="cancel" />
		</lv_keyboard>
	</view>
</component>
