<screen>
	<styles>
		<style
			name="ui_styleMainScreen"
			width="content"
			height="content"
			border_width="0"
			border_color="0xffffff"
			bg_color="0x000000"
		/>
		<style name="ui_styleVfoText" text_color="0xff6918" text_font="ui_font_Monaco40" text_align="right" />
		<style
			name="ui_styleDialMain"
			width="content"
			height="content"
			border_width="0"
			border_color="0xffffff"
			bg_color="0x000000"
			text_font="ui_font_Monaco22"
		/>
		<style name="ui_styleDialScaleText" text_color="0xff6918" text_font="ui_font_Monaco22" />
		<style name="ui_styleDialScaleTextPortait" pad_ver="10" />
		<style name="ui_styleDialScaleMinorTicks" line_color="0xffffff" line_width="2" line_opa="100%" length="20" />
		<style name="ui_styleDialScaleMajorTicks" line_color="0xffffff" line_width="2" line_opa="100%" length="32" />
		<style name="ui_styleVfoKeyboard" bg_color="0xffffff" text_color="0xff6918" bg_opa="5%" />
	</styles>
	<view name="ui_MainScreen" scrollbar_mode="off">
		<style name="ui_styleMainScreen" />
		<lv_textarea
			name="ui_vfoDisp"
			align="top_mid"
			width="180"
			height="70"
			click_focusable="true"
			scrollbar_mode="off"
			placeholder_text="Set Freq"
			text="102.5"
			style_radius="0"
			style_bg_opa="0"
			style_border_width="0"
			one_line="true"
		>
			<style name="ui_styleVfoText" />
			<lv_obj-subject_set_int_event subject="vfo_keyboard_visible" value="1" trigger="clicked" />
		</lv_textarea>

		<lv_obj
			name="ui_dialScaleBackground"
			width="320"
			height="120"
			align="center"
			scrollbar_mode="off"
			scroll_chain_hor="false"
			scroll_chain_ver="false"
			scroll_elastic="false"
			scroll_momentum="false"
			style_radius="0"
			style_bg_color="0x000000"
			style_border_width="0"
			style_pad_all="0"
			scrollable="false"
			style_transform_pivot_x="160"
			style_transform_pivot_y="60"
			style_transform_rotation="900"
		>
			<lv_obj
				name="ui_dialContainer"
				align="bottom_mid"
				width="320"
				height="120"
				style_bg_color="0x000000"
				style_border_width="0"
				style_radius="0"
				style_pad_all="0"
				style_pad_bottom="0"
				scrollbar_mode="off"
				scroll_chain_ver="false"
				scroll_chain_hor="false"
				scrollable="false"
			>
				<dial_scale_widget
					name="ui_mainDial"
					align="bottom_mid"
					frame_width="320"
					frame_height="120"
					min_value="8800"
					max_value="10800"
					total_tick_count="201"
					major_tick_every="10"
					scale_pixel_width="2330"
					style_pad_hor="160"
					text_src="88.00\n89.00\n90.00\n91.00\n92.00\n93.00\n94.00\n95.00\n96.00\n97.00\n98.00\n99.00\n100.00\n101.00\n102.00\n103.00\n104.00\n105.00\n106.00\n107.00\n108.00"
					needle_src="needle"
					overlay_src="overlay"
				/>
			</lv_obj>
		</lv_obj>
		<lv_keyboard name="ui_vfoKeyboard" width="320" height="110" mode="number" style_bg_color="0x101010">
			<style name="ui_styleVfoKeyboard" selector="items" />
			<style name="ui_styleVfoKeyboard" selector="items|checked" />
			<lv_obj-bind_flag_if_eq subject="vfo_keyboard_visible" flag="hidden" ref_value="0" />
			<lv_obj-subject_set_int_event subject="vfo_keyboard_visible" value="0" trigger="ready" />
			<lv_obj-subject_set_int_event subject="vfo_keyboard_visible" value="0" trigger="cancel" />
		</lv_keyboard>
	</view>
</screen>
